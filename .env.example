DATABASE_URL=postgresql+asyncpg://procurement:procurement@127.0.0.1:15432/procurement
POSTGRES_DB=procurement
POSTGRES_USER=procurement
POSTGRES_PASSWORD=procurement
POSTGRES_PORT=15432
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILENAME=procurement-parser.jsonl
REVISION_MODE=changes

# Optional proxy secrets. Include credentials directly in PROXY_URL.
PROXY_URL=
PROXY_ROTATE_URL=
PROXY_POOL_FILE=
PROXY_POOL_INDEX=0

# Optional global overrides. Leave commented to use the selected TOML profiles.
# NETWORK_MAX_LANES=4
# WORKER_COUNT=12
# BROWSER_LANES=2
# METRICS_PORT=9108

# Docker host metrics ports.
EEP_METRICS_PORT=9108
ZAKUP_METRICS_PORT=9109
SCHEDULER_EEP_METRICS_PORT=9110
SCHEDULER_ZAKUP_METRICS_PORT=9111

# Docker profiles may override source-specific runtime/network settings.
EEP_RUNTIME_PROFILE=server
ZAKUP_RUNTIME_PROFILE=server
SCHEDULER_RUNTIME_PROFILE=server
EEP_NETWORK_PROFILE=direct
ZAKUP_NETWORK_PROFILE=direct
SCHEDULER_EEP_NETWORK_PROFILE=direct
SCHEDULER_ZAKUP_NETWORK_PROFILE=direct
CAPTCHA_PROFILE=disabled

# Optional, enabled only with --captcha 2captcha.
TWOCAPTCHA_API_KEY=
CAPTCHA_MAX_COST_PER_HOUR=1.00
